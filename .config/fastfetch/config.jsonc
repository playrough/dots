{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$(~/.config/fastfetch/random-logo.sh)",
    "color": {
      "1": "32"
    },
    "padding": {
      "left": 5,
      "right": 6,
      "top": 1
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom"
    },
    {
      "type": "custom"
    },
    { 
      "type": "custom"
    },
    { 
      "type": "custom"
    },
    { 
      "type": "custom"
    },
    { 
      "type": "custom"
    },
    {
      "type": "title",
      "key": "{#32}User    ",
      "format": "{user-name}"
    },
    {
      "type": "os",
      "key": "{#32}OS      ",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "{#32}Kernel  ",
      "format": "{release}"
    },
    {
      "type": "de",
      "key": "{#32}DE      "
    },
    {
      "type": "wm",
      "key": "{#32}WM      ",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "key": "{#32}Display ",
      "format": "{width}x{height} @{refresh-rate}Hz"
    },
    {
      "type": "terminal",
      "key": "{#32}Terminal",
      "format": "{pretty-name}"
    },

    {
      "type": "cpu",
      "key": "{#32}CPU     ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "{#32}GPU     ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#32}Memory  ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "{#32}Disk    ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },

    {
      "type": "custom",
      "format": ""
    },

    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    },
    // Footer
    {
      "type": "custom",
      "format": ""
    }
  ]
}
