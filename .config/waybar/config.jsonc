{
  "layer": "top",
  "position": "top",
  "margin-top": 10,
  "spacing": 4,
  "modules-left": [
    "hyprland/window",
    "cava",
    "custom/mpris",
  ],
  "modules-center": [
    "hyprland/workspaces",
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "battery#bat2",
    "clock",
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
